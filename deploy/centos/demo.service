# 2026/10/29 gongml [需求 待补充] 后端 systemd 服务
[Unit]
Description=Demo Backend
After=network.target mysqld.service redis.service
Wants=mysqld.service redis.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/demo
EnvironmentFile=/opt/demo/.env
ExecStart=/opt/java/bin/java -Xms256m -Xmx512m -jar /opt/demo/app.jar --spring.profiles.active=prod
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
